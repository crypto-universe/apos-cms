# ==============================================
# ApostropheCMS Environment Variables
# ==============================================
# Скопируйте этот файл в .env и заполните значения

# ==============================================
# ANTHROPIC API (Claude AI Integration)
# ==============================================
# Получите ключ API на: https://console.anthropic.com/
# Требуется для работы AI Assistant модуля
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ==============================================
# NEWSLETTER MODULE
# ==============================================
# Секретный ключ для генерации токенов отписки
# Используйте случайную строку, например: openssl rand -hex 32
UNSUBSCRIBE_SECRET=your-random-secret-key-change-this-in-production

# ==============================================
# SMTP Configuration (для отправки email)
# ==============================================
# Настройки SMTP сервера для отправки писем
# Примеры провайдеров: Gmail, SendGrid, Mailgun, Amazon SES

# SMTP хост (например: smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.example.com

# SMTP порт (обычно 587 для TLS, 465 для SSL, 25 для незащищенного)
SMTP_PORT=587

# Использовать SSL (true для порта 465, false для 587)
SMTP_SECURE=false

# SMTP пользователь (email или username)
SMTP_USER=your-email@example.com

# SMTP пароль
SMTP_PASS=your-smtp-password

# От кого отправлять письма
SMTP_FROM="Техно-Агенсио <noreply@agenc.io>"

# ==============================================
# ПРИМЕРЫ КОНФИГУРАЦИИ ДЛЯ ПОПУЛЯРНЫХ СЕРВИСОВ
# ==============================================

# --- Gmail ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password (не обычный пароль! создайте App Password)

# --- SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# --- Mailgun ---
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASS=your-mailgun-smtp-password

# --- Amazon SES ---
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-ses-smtp-username
# SMTP_PASS=your-ses-smtp-password

# ==============================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ==============================================

# Node.js окружение
NODE_ENV=development

# База данных MongoDB (если не используете Apostrophe по умолчанию)
# MONGODB_URI=mongodb://localhost:27017/your-database

# Базовый URL сайта (важно для email ссылок)
# Устанавливается в app.js как baseUrl
# BASE_URL=https://new.agenc.io

# ==============================================
# БЕЗОПАСНОСТЬ
# ==============================================
# ВАЖНО: Никогда не коммитьте .env файл в git!
# Добавьте .env в .gitignore
# Используйте сильные пароли и секретные ключи
# Регулярно меняйте ключи API и секреты

# Генерация случайного секрета:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ==============================================
# PRODUCTION CHECKLIST
# ==============================================
# ✅ Установите ANTHROPIC_API_KEY
# ✅ Смените UNSUBSCRIBE_SECRET на случайную строку
# ✅ Настройте SMTP для отправки email
# ✅ Установите NODE_ENV=production
# ✅ Проверьте BASE_URL в app.js
# ✅ Убедитесь что .env добавлен в .gitignore
# ✅ Используйте https:// в production
